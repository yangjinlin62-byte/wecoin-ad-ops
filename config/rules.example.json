{
  "version": 1,
  "_说明": "这是配置模板。首次运行 node scripts/setup.js 会自动生成 config/rules.json，通常不需要手改。",
  "accounts": [
    {
      "id": "account1",
      "label": "（setup 自动填：投放账户名）",
      "operator": "（setup 自动填：登录的管理员）",
      "cdpPort": 9444,
      "cashFloor": 3000,
      "_说明": "cashFloor 是保留余额，建单时不会花掉这部分"
    }
  ],
  "targeting": {
    "ageRange": [],
    "note": "[] 表示不限年龄；[2,3,4] 表示 25-29/30-39/40-49"
  },
  "videoWindow": {
    "minCreateTime": "2026-07-01T00:00:00+08:00"
  },
  "batch": {
    "maxVideos": 60,
    "maxPlans": 50,
    "allowedBudgets": [300, 600, 800, 1000, 1200, 1300, 1400, 1500, 2000]
  },
  "bidCaps": {
    "成交数": { "min": 90, "max": 110, "hardMax": 130 },
    "成交ROI": { "min": 0.6, "max": 0.8, "recommended": 0.7 },
    "净ROI": { "min": 0.6, "max": 0.8, "recommended": 0.7 },
    "净成交数": { "min": 600, "max": 700, "budgetMultiplier": 2 }
  },
  "productTiers": {
    "_说明": "商品ID → 价格层。setup 会扫描并填入实际商品的 ID",
    "10000501804864": "59.9",
    "10001808219265": "399"
  },
  "billing": {
    "default": "mix",
    "_说明": "mix = 实时:预付 1:1；realtime = 全实时（微信豆多、现金少时用）"
  }
}
